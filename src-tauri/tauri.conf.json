{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cursive",
  "version": "0.3.1",
  "identifier": "com.dwarsbit.cursive",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cursive",
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 16,
          "y": 32
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.zotero.org https://api.crossref.org https://openlibrary.org https://app.scholarkit.app",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzM0VDOEQ1N0Y4MDU5RkUKUldUK1dZQi8xY2crQXpsL213b3IrRmVuL0UvOUdXYmhoakVrd2dRbVd4MWhsZkpsZVJLeHNwWkMK",
      "endpoints": [
        "https://app.scholarkit.app/api/updates/cursive/{{target}}/{{arch}}/{{bundle_type}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A Markdown editor for notes",
    "longDescription": "Cursive is a Markdown editor in the style of Notion. Write in a visual mode with no Markdown syntax, switch to Markdown when you want the source, and keep your pages as files on your disk.",
    "copyright": "Copyright (c) 2026 Leon"
  }
}
